/-- MDS matrix, materialized (`t*t = 9`). -/
def MDS : Array Fr := #[
  1331,
  14641,
  161051,
  1771561,
  19487171,
  214358881,
  2357947691,
  25937424601,
  285311670611]


/-- S-box: fifth power. -/
def sbox (x : Fr) : Fr := x ^ 5

/-- Add round constants for round `r`. -/
def ark (s : Vector Fr t) (r : Nat) : Vector Fr t :=
  Vector.ofFn (fun i => s[i] + RC[r * t + i.val]!)

/-- MDS mixing: `out[i] = Σ_j MDS[i*t+j] * s[j]`. -/
def mix (s : Vector Fr t) : Vector Fr t :=
  Vector.ofFn (fun i => (List.range t).foldl (fun acc j => acc + MDS[i.val * t + j]! * s[j]!) 0)

/-- A full round (S-box on every element). -/
def fullRound (s : Vector Fr t) (r : Nat) : Vector Fr t :=
  let a := ark s r
  mix (Vector.ofFn (fun i => sbox a[i]))

/-- A partial round (S-box on the first element only). -/
def partialRound (s : Vector Fr t) (r : Nat) : Vector Fr t :=
  let a := ark s r
  mix (Vector.ofFn (fun i => if i.val = 0 then sbox a[i] else a[i]))

/-- One round, full or partial depending on the round index. -/
def round (s : Vector Fr t) (r : Nat) : Vector Fr t :=
  if r < RF / 2 || r >= RF / 2 + RP then fullRound s r else partialRound s r

/-- The permutation: fold `round` over all rounds. -/
def perm (s0 : Vector Fr t) : Vector Fr t :=
  (List.range nRounds).foldl round s0

/-- 2-to-1 hash: absorb `a`, `b` into a rate-2 state, permute, squeeze the first lane. -/
def hash2 (a b : Fr) : Fr := (perm ⟨#[0, a, b], rfl⟩)[0]

/-- Wrapped as a `Free` program so we can `reflect%` it. -/
def poseidonF (a b : Fr) : Free CircOp HintS Fr := pure (hash2 a b)

